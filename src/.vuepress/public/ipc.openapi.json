      }
    },
    "/v1/stop": {
      "post": {
        "operationId": "stopCurrent",
        "summary": "停止本机或请求当前教室停止",
        "responses": {
          "200": {
            "description": "本机停止或远端请求已提交。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "stopped"
                      ],
                      "properties": {
                        "stopped": {
                          "type": "boolean"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "requested"
                      ],
                      "properties": {
                        "requested": {
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求或执行失败，参见 error。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "请求或执行失败，参见 error。",
            "content": {
