                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "localToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "对应端 IPC 配置的 Token；不是登录令牌。"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "TextShout": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "pattern": "\\S"
          },
          "speak": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Accepted": {
        "type": "object",
        "required": [
          "id",
          "accepted",
          "duplicate"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "accepted": {
            "type": "boolean"
          },
          "duplicate": {
            "type": "boolean"
          }
        }
      },
      "ClassroomStatus": {
        "type": "object",
        "required": [
          "classroom",
          "muted",
          "volume",
          "apiVersion"
        ],
        "properties": {
          "classroom": {
            "type": "string"
          },
          "muted": {
            "type": "boolean"
          },
          "volume": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "apiVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          }
        }
      },
      "TeacherStatus": {
        "type": "object",
        "required": [
          "connected",
          "classroom",
          "apiVersion",
          "role"
        ],
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "classroom": {
            "type": "string"
          },
          "apiVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "teacher"
            ]
          }
        }
      },
      "Stage": {
        "type": "string",
        "enum": [
          "sent",
          "delivered",
          "displayed",
          "completed",
          "failed"
        ]
      },
      "DeliveryEvent": {
        "type": "object",
        "required": [
          "stage",
          "at"
        ],
        "properties": {
          "stage": {
            "$ref": "#/components/schemas/Stage"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "detail": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Receipt": {
        "type": "object",
        "required": [
          "id",
          "stage",
          "timeline"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "stage": {
            "$ref": "#/components/schemas/Stage"
          },
          "failure": {
            "type": "string",
            "nullable": true
          },
          "timeline": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeliveryEvent"
            }
          }
        }
      }
    }
  }
}
