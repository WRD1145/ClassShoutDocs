{
  "openapi": "3.0.3",
  "info": {
    "title": "ClassShout 本机 HTTP IPC",
    "version": "1.0.0",
    "description": "独立于托管插件 SDK；仅限可信本机应用。回环监听、Bearer 令牌、32 KiB 正文、5 秒连接、4 并发。配置分离适用于开发版，路由兼容 1.21.0。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:45903",
      "description": "教室端"
    },
    {
      "url": "http://127.0.0.1:45904",
      "description": "桌面教师端"
    }
  ],
  "security": [
    {
      "localToken": []
    }
  ],
  "paths": {
    "/v1/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "读取当前端状态",
        "responses": {
          "200": {
            "description": "对应端状态，不代表消息执行。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ClassroomStatus"
                    },
                    {
                      "$ref": "#/components/schemas/TeacherStatus"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "请求或执行失败，参见 error。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "请求或执行失败，参见 error。",
            "content": {
              "application/json": {
                "schema": {
